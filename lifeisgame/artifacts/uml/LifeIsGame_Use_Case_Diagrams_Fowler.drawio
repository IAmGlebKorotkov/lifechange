        <mxCell id="assoc-12" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#475569;strokeWidth=1.5;" parent="1" edge="1" source="actor-5" target="uc-8">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note-13" value="Неавторизованный пользователь — ведущий актор всех трёх целей. Служба Face ID iOS — второстепенный актор только UC03. Сохранение сессии и резервный вход описаны в сценариях." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#374151;fillColor=#FFF7D6;strokeColor=#D6B656;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="500" y="720" width="680" height="105" />
