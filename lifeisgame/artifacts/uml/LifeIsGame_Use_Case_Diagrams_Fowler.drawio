<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="page-0" name="00 Принципы модели">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-2" value="&lt;b&gt;Как читать модель вариантов использования&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#475569'&gt;Правила главы 9 книги Мартина Фаулера&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="180" y="15" width="1340" height="60" />
        </mxCell>
        <mxCell id="card-3" value="&lt;b&gt;Актор&lt;/b&gt;&lt;br&gt;&lt;br&gt;Внешняя по отношению к LifeIsGame &lt;b&gt;роль&lt;/b&gt;, которая взаимодействует с системой. Основные роли: неавторизованный и авторизованный пользователь. Службы iOS — второстепенные акторы, потому что LifeIsGame обменивается с ними данными." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;fontSize=14;fontColor=#1F2937;fillColor=#E0F2FE;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="110" y="130" width="430" height="230" />
        </mxCell>
        <mxCell id="card-4" value="&lt;b&gt;Вариант использования&lt;/b&gt;&lt;br&gt;&lt;br&gt;Не экран и не отдельная проверка, а набор сценариев с одной целью актора. Проверка почты, сортировка, расчёт сна, сохранение сессии и обновление прогресса описываются как шаги и гарантии сценариев." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;fontSize=14;fontColor=#1F2937;fillColor=#DBEAFE;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="635" y="130" width="430" height="230" />
        </mxCell>
        <mxCell id="card-5" value="&lt;b&gt;Связи&lt;/b&gt;&lt;br&gt;&lt;br&gt;Сплошная линия — участие актора. «include» — обязательный повторно используемый сложный шаг. В модели только два include: создание обычной и сложной задачи включает автоматическое планирование. UML-отношение extend не применяется: условные ветви записаны в тексте сценариев." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;fontSize=14;fontColor=#1F2937;fillColor=#F3E8FF;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1160" y="130" width="430" height="230" />
        </mxCell>
        <mxCell id="card-6" value="&lt;b&gt;Граница системы&lt;/b&gt;&lt;br&gt;&lt;br&gt;Все овалы находятся внутри прямоугольника LifeIsGame. Все акторы — снаружи. LifeIsGame не является собственным актором и не соединяется линиями с акторами." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;fontSize=14;fontColor=#1F2937;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="110" y="430" width="430" height="190" />
        </mxCell>
        <mxCell id="card-7" value="&lt;b&gt;Уровни&lt;/b&gt;&lt;br&gt;&lt;br&gt;Большинство прецедентов — «уровень моря»: самостоятельная цель пользователя. UC15 «Автоматически сформировать план» — «уровень рыб»: он существует как включаемое поведение." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;fontSize=14;fontColor=#1F2937;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="635" y="430" width="430" height="190" />
        </mxCell>
        <mxCell id="card-8" value="&lt;b&gt;Где находятся детали&lt;/b&gt;&lt;br&gt;&lt;br&gt;Диаграммы дают обзор взаимодействий. Полное функциональное содержание — в приложенном текстовом описании: предусловия, триггеры, главный успешный сценарий, расширения и гарантии." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;arcSize=12;fontSize=14;fontColor=#1F2937;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1160" y="430" width="430" height="190" />
        </mxCell>
        <mxCell id="note-9" value="Сквозное требование интерфейса: переход между разделами «Календарь», «Дневник», «Анализ дня», «Статистика» и «Профиль» выполняется через TabBar. Это правило интерфейса, а не самостоятельная цель актора, поэтому отдельного овала для TabBar нет." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#374151;fillColor=#FFF7D6;strokeColor=#D6B656;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="320" y="710" width="1060" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-1" name="01 Регистрация и авторизация">
