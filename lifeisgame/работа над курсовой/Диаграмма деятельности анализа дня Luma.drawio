        <mxCell id="p2-e4" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" source="p2-sleep-today-decision" target="p2-use-today-sleep" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e5" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" source="p2-sleep-today-decision" target="p2-yesterday-decision" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e6" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" source="p2-yesterday-decision" target="p2-use-yesterday" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e7" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" source="p2-yesterday-decision" target="p2-no-sleep" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;" parent="1" source="p2-use-today-sleep" target="p2-sleep-merge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;" parent="1" source="p2-use-yesterday" target="p2-sleep-merge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
