        <mxCell id="p2-input" value="Получить пользователя, дату,&lt;br&gt;задачи сегодня и завтра,&lt;br&gt;записи сна и эмоций" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="45" y="220" width="250" height="96" as="geometry" /></mxCell>
        <mxCell id="p2-age" value="Определить возраст и&lt;br&gt;рекомендуемый диапазон сна" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="420" y="220" width="300" height="78" as="geometry" /></mxCell>
        <mxCell id="p2-sleep-today-decision" value="Есть запись сна&lt;br&gt;за текущий день?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=4;" parent="1" vertex="1"><mxGeometry x="515" y="350" width="110" height="92" as="geometry" /></mxCell>
        <mxCell id="p2-use-today-sleep" value="Использовать запись&lt;br&gt;текущего дня" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="345" y="500" width="210" height="68" as="geometry" /></mxCell>
        <mxCell id="p2-yesterday-decision" value="Есть запись сна&lt;br&gt;за вчера?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=4;" parent="1" vertex="1"><mxGeometry x="645" y="490" width="105" height="90" as="geometry" /></mxCell>
        <mxCell id="p2-use-yesterday" value="Использовать запись&lt;br&gt;за вчера" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="500" y="635" width="200" height="68" as="geometry" /></mxCell>
        <mxCell id="p2-no-sleep" value="Отметить отсутствие&lt;br&gt;актуальных данных сна" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="610" y="735" width="200" height="72" as="geometry" /></mxCell>
        <mxCell id="p2-sleep-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" parent="1" vertex="1"><mxGeometry x="550" y="855" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-sleep-trend" value="Рассчитать за последние 7 дней:&lt;br&gt;среднюю длительность сна и&lt;br&gt;разброс времени отхода ко сну" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="400" y="950" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="p2-tasks" value="Развернуть сложные задачи в подзадачи;&lt;br&gt;разделить задачи на выполненные&lt;br&gt;и оставшиеся; оставить на завтра&lt;br&gt;только незавершённые" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="380" y="1090" width="380" height="108" as="geometry" /></mxCell>
        <mxCell id="p2-emotions" value="По эмоциям текущего дня рассчитать:&lt;br&gt;средний баланс, максимальное&lt;br&gt;напряжение и максимальную поддержку" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="390" y="1250" width="360" height="96" as="geometry" /></mxCell>

        <mxCell id="p2-resource" value="Рассчитать ресурс 0–100&lt;br&gt;&lt;font style='font-size:12px;color:#000000'&gt;сон: текущий 65% + среднее 7 дней 35%;&lt;br&gt;эмоции: 55 + поддержка×25 − напряжение×40;&lt;br&gt;веса нормируются по доступным данным,&lt;br&gt;если данных нет — 50&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=8;" parent="1" vertex="1"><mxGeometry x="865" y="1250" width="410" height="138" as="geometry" /></mxCell>
        <mxCell id="p2-workload" value="Рассчитать нагрузку задач&lt;br&gt;на сегодня и завтра по количеству,&lt;br&gt;длительности, сложности и важности" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="865" y="1440" width="410" height="92" as="geometry" /></mxCell>
        <mxCell id="p2-load" value="Рассчитать фактическую нагрузку дня 0–100&lt;br&gt;&lt;font style='font-size:12px;color:#000000'&gt;доступное время − события календаря;&lt;br&gt;оставшиеся трудозатраты 80%, выполненные 12%,&lt;br&gt;просрочки 6%, количество элементов 2%&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=8;" parent="1" vertex="1"><mxGeometry x="855" y="1580" width="430" height="116" as="geometry" /></mxCell>
        <mxCell id="p2-balance" value="Рассчитать баланс 0–100&lt;br&gt;50 + (ресурс − нагрузка) × 0,65" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="875" y="1740" width="390" height="78" as="geometry" /></mxCell>
        <mxCell id="p2-confidence" value="Рассчитать точность 0–100&lt;br&gt;&lt;font style='font-size:12px;color:#000000'&gt;20 базовых + возраст 10 + сон 30 +&lt;br&gt;не менее 3 записей сна 15 + эмоции 25&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="855" y="1860" width="430" height="96" as="geometry" /></mxCell>
        <mxCell id="p2-confidence-decision" value="Точность&lt;br&gt;ниже 45?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=4;" parent="1" vertex="1"><mxGeometry x="1015" y="2005" width="110" height="86" as="geometry" /></mxCell>
        <mxCell id="p2-readiness-resource" value="Итоговая готовность = ресурс;&lt;br&gt;результат предварительный" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="835" y="2150" width="240" height="76" as="geometry" /></mxCell>
        <mxCell id="p2-readiness-balance" value="Итоговая готовность = баланс;&lt;br&gt;точность средняя или высокая" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="1085" y="2150" width="220" height="76" as="geometry" /></mxCell>
        <mxCell id="p2-readiness-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" parent="1" vertex="1"><mxGeometry x="1050" y="2290" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-level" value="Определить уровень нагрузки:&lt;br&gt;&lt;font style='font-size:12px;color:#000000'&gt;0–27 — низкая; 28–57 — сбалансированная;&lt;br&gt;58–77 — высокая; 78–100 — перегруз&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="855" y="2390" width="430" height="92" as="geometry" /></mxCell>

        <mxCell id="p2-summary" value="Сформировать краткое описание&lt;br&gt;и сигналы по рассчитанным метрикам" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="1355" y="1860" width="390" height="78" as="geometry" /></mxCell>
        <mxCell id="p2-advice" value="Сформировать кандидаты рекомендаций:&lt;br&gt;сон, перегруз, просрочки,&lt;br&gt;нагрузка завтра и эмоции" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="1355" y="1990" width="390" height="92" as="geometry" /></mxCell>
        <mxCell id="p2-advice-decision" value="Есть хотя бы одна&lt;br&gt;рекомендация?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=4;" parent="1" vertex="1"><mxGeometry x="1495" y="2135" width="110" height="90" as="geometry" /></mxCell>
        <mxCell id="p2-default-advice" value="Добавить рекомендацию&lt;br&gt;«День выглядит устойчиво»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="1335" y="2280" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="p2-advice-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" parent="1" vertex="1"><mxGeometry x="1530" y="2400" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-top-four" value="Отсортировать рекомендации&lt;br&gt;по приоритету и оставить не более 4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;spacing=8;" parent="1" vertex="1"><mxGeometry x="1360" y="2480" width="380" height="78" as="geometry" /></mxCell>
        <mxCell id="p2-output" value="Вернуть результат анализа:&lt;br&gt;готовность, ресурс, нагрузка, баланс,&lt;br&gt;точность, уровень, сигналы и советы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=8;" parent="1" vertex="1"><mxGeometry x="1350" y="2600" width="400" height="94" as="geometry" /></mxCell>
        <mxCell id="p2-final" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1536" y="2720" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p2-final-dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1542" y="2726" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="p2-final-label" value="&lt;b&gt;Конец&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1575" y="2722" width="70" height="24" as="geometry" /></mxCell>

        <mxCell id="p2-note-time" value="&lt;b&gt;Текущая реализация&lt;/b&gt;&lt;br&gt;Доступное время анализа считается от текущего момента или 08:00 до 22:00 и ограничивается восемью часами. События календаря уменьшают этот резерв." style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;spacing=10;" parent="1" vertex="1"><mxGeometry x="40" y="1510" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="p2-note-emotion" value="&lt;b&gt;Обработка эмоций&lt;/b&gt;&lt;br&gt;Интенсивность делится на 10 и умножается на направленность эмоции. Сильная отрицательная эмоция не компенсируется положительной при расчёте напряжения." style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;spacing=10;" parent="1" vertex="1"><mxGeometry x="35" y="1730" width="270" height="170" as="geometry" /></mxCell>

        <mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" source="p2-start" target="p2-input" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" source="p2-input" target="p2-age" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
