        <mxCell id="p6-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p6-load-advice" target="p6-overdue-advice" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
