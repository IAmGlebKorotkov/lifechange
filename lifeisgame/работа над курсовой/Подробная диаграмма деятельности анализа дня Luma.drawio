        <mxCell id="p2-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p2-select-today" target="p2-sleep-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p2-select-yesterday" target="p2-sleep-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p2-no-sleep" target="p2-sleep-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p2-sleep-merge" target="p2-sleep-duration" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
