        <mxCell id="p2-e28" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p2-emotion-empty" target="p2-emotion-zero" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
