  <diagram id="advice-result" name="6. Рекомендации и результат">
    <mxGraphModel dx="2100" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1950" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p6-title" value="&lt;b&gt;Подпроцесс 5. Формирование рекомендаций и результата анализа дня&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#000000;fontSize=20;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="20" width="2060" height="65" as="geometry"/></mxCell>
        <mxCell id="p6-lane-engine" value="&lt;b&gt;UserAnalysisEngine&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;dashPattern=3 3;fontSize=15;fontColor=#000000;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="20" y="105" width="620" height="1740" as="geometry"/></mxCell>
        <mxCell id="p6-lane-advice" value="&lt;b&gt;UserAnalysisAdviceEngine&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;dashPattern=3 3;fontSize=15;fontColor=#000000;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="640" y="105" width="1040" height="1740" as="geometry"/></mxCell>
        <mxCell id="p6-lane-ui" value="&lt;b&gt;Экран анализа&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;dashPattern=3 3;fontSize=15;fontColor=#000000;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1680" y="105" width="400" height="1740" as="geometry"/></mxCell>
        <mxCell id="p6-frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" parent="1" vertex="1"><mxGeometry x="20" y="105" width="2060" height="1740" as="geometry"/></mxCell>
        <mxCell id="p6-start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="90" y="180" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="p6-start-label" value="&lt;b&gt;Начало&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="25" y="178" width="55" height="24" as="geometry"/></mxCell>
        <mxCell id="p6-input" value="Получить metrics, readinessScore,&lt;br&gt;loadScore, todayItems, tomorrowItems и date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="160" y="155" width="400" height="72" as="geometry"/></mxCell>
        <mxCell id="p6-sleep-advice" value="Сформировать sleepAdvice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="720" y="155" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="p6-sleep-rule" value="Если sleepMinutes отсутствует → «Добавь сон», medium.&lt;br&gt;Иначе если sleepMinutes &lt; lowerBound → «Сон снижает ресурс», high;&lt;br&gt;текст зависит от того, date.hour &lt; 12 или нет.&lt;br&gt;Иначе рекомендация отсутствует." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1050" y="135" width="540" height="110" as="geometry"/></mxCell>
        <mxCell id="p6-load-advice" value="Сформировать loadAdvice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="720" y="300" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="p6-load-rule" value="loadScore ≥ 78 → «План больше доступного времени», high;&lt;br&gt;58…77 → «Нагрузка высокая», medium;&lt;br&gt;&lt; 58 → рекомендация отсутствует.&lt;br&gt;При перегрузе: сохранить задачу с максимальными importance/difficulty;&lt;br&gt;для переноса выбрать среди остальных наименее важную (при равенстве — более длительную)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1050" y="270" width="560" height="145" as="geometry"/></mxCell>
        <mxCell id="p6-overdue-advice" value="Сформировать overdueAdvice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="720" y="455" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="p6-overdue-rule" value="Если overdueTaskCount &gt; 0 и найдена первая задача с deadlineDate &lt; date →&lt;br&gt;«Есть просроченная задача», high. Иначе рекомендация отсутствует." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1050" y="440" width="540" height="82" as="geometry"/></mxCell>
        <mxCell id="p6-tomorrow-advice" value="Сформировать tomorrowAdvice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="720" y="590" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="p6-tomorrow-rule" value="Если tomorrowWorkloadScore ≥ 65 ИЛИ tomorrowTaskCount ≥ 7 →&lt;br&gt;«Завтра высокая нагрузка», high; в сообщение добавить самую важную задачу.&lt;br&gt;Иначе рекомендация отсутствует." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1050" y="570" width="540" height="95" as="geometry"/></mxCell>
        <mxCell id="p6-emotion-advice" value="Сформировать emotionAdvice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="720" y="730" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="p6-emotion-rule" value="Нет emotionBalance → «Отметь эмоции», info;&lt;br&gt;иначе strain ≥ 0,45 → «Есть эмоциональное напряжение», medium;&lt;br&gt;иначе support ≥ 0,45 И readinessScore ≥ 60 → «Есть ресурс для важного», info;&lt;br&gt;иначе рекомендация отсутствует." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1050" y="705" width="540" height="120" as="geometry"/></mxCell>

        <mxCell id="p6-compact" value="Удалить отсутствующие рекомендации&lt;br&gt;(compactMap)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="740" y="880" width="320" height="64" as="geometry"/></mxCell>
        <mxCell id="p6-empty" value="Список пуст?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1150" y="865" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="p6-default" value="Добавить «День выглядит устойчиво»&lt;br&gt;с приоритетом info" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1370" y="850" width="280" height="66" as="geometry"/></mxCell>
        <mxCell id="p6-advice-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1450" y="980" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p6-sort" value="Отсортировать по убыванию priority;&lt;br&gt;оставить первые 4 рекомендации" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1050" y="1000" width="340" height="66" as="geometry"/></mxCell>

        <mxCell id="p6-summary-decision" value="confidenceLevel = low?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" parent="1" vertex="1"><mxGeometry x="210" y="850" width="150" height="96" as="geometry"/></mxCell>
        <mxCell id="p6-summary-low" value="summary = «Предварительный анализ:&lt;br&gt;данных пока недостаточно…»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="70" y="1000" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="p6-summary-normal" value="summary = ресурс/100, нагрузка/100,&lt;br&gt;сон, выполненные и оставшиеся задачи,&lt;br&gt;число задач на завтра" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="380" y="990" width="240" height="86" as="geometry"/></mxCell>
        <mxCell id="p6-summary-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="270" y="1120" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p6-signals" value="Сформировать signals:&lt;br&gt;ресурс, нагрузка, баланс, точность,&lt;br&gt;доступное/оставшееся/выполненное время, сон и тренд,&lt;br&gt;задачи завтра, события, просрочки, напряжение и поддержка" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="100" y="1210" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="p6-result" value="Создать UserAnalysisResult:&lt;br&gt;readinessScore, resourceScore, loadScore, balanceScore,&lt;br&gt;confidenceScore/level, workloadLevel,&lt;br&gt;summary, signals, advices и metrics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="760" y="1240" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="p6-return" value="Вернуть результат через completion(.success)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="160" y="1430" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="p6-display" value="Обновить карточку анализа,&lt;br&gt;сигналы и рекомендации" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1740" y="1425" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="p6-note-reload" value="При повторном появлении экрана, а также после уведомлений об изменении задач или дневника анализ запускается заново и использует актуальные данные." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1710" y="1180" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p6-final" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1870" y="1580" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="p6-final-dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1877" y="1587" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="p6-final-label" value="&lt;b&gt;Конец&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1915" y="1585" width="70" height="24" as="geometry"/></mxCell>

        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p6-start" target="p6-input" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p6-input" target="p6-sleep-advice" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
