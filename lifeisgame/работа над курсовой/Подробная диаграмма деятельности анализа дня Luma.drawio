        <mxCell id="p2-e9" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p2-sleep-today" target="p2-select-today" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e10" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p2-sleep-today" target="p2-sleep-yesterday" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e11" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p2-sleep-yesterday" target="p2-select-yesterday" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
