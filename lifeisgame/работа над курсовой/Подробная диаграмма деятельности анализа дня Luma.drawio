  <diagram id="resource-calculation" name="3. Расчёт ресурса">
    <mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="&lt;b&gt;Подпроцесс 2. Расчёт оценки ресурса пользователя&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#000000;fontSize=20;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="20" width="1860" height="65" as="geometry"/></mxCell>
        <mxCell id="p3-lane" value="&lt;b&gt;UserAnalysisEngine&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=15;fontColor=#000000;align=center;verticalAlign=top;spacingTop=8;" parent="1" vertex="1"><mxGeometry x="20" y="105" width="1860" height="1300" as="geometry"/></mxCell>
        <mxCell id="p3-start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="80" y="180" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-start-label" value="&lt;b&gt;Начало&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="25" y="178" width="45" height="24" as="geometry"/></mxCell>
        <mxCell id="p3-input" value="Получить sleepMinutes, averageSleepMinutes,&lt;br&gt;recommendedSleepRange, strain, support,&lt;br&gt;признак наличия эмоций" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="150" y="155" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="p3-components" value="components = []" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="590" y="165" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="p3-has-sleep" value="sleepMinutes&lt;br&gt;существует?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="880" y="145" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="p3-current" value="currentSleepScore = sleepScore(&lt;br&gt;sleepMinutes, recommendedRange)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1090" y="125" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="p3-sleep-score-note" value="sleepScore(minutes):&lt;br&gt;если minutes ≥ lowerBound → 100;&lt;br&gt;иначе max(0, minutes / lowerBound × 100).&lt;br&gt;Верхняя граница диапазона в этой формуле не снижает оценку." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1450" y="115" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="p3-has-average" value="averageSleepMinutes&lt;br&gt;существует?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1145" y="265" width="150" height="96" as="geometry"/></mxCell>
        <mxCell id="p3-trend-score" value="trendSleepScore =&lt;br&gt;sleepScore(averageSleepMinutes)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1410" y="260" width="280" height="64" as="geometry"/></mxCell>
        <mxCell id="p3-trend-current" value="trendSleepScore =&lt;br&gt;currentSleepScore" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1410" y="355" width="280" height="58" as="geometry"/></mxCell>
        <mxCell id="p3-trend-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1725" y="315" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p3-combined" value="combinedSleepScore =&lt;br&gt;current × 0,65 + trend × 0,35" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1420" y="465" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="p3-add-sleep" value="Добавить компонент&lt;br&gt;(combinedSleepScore, weight = 0,65)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1030" y="465" width="310" height="64" as="geometry"/></mxCell>
        <mxCell id="p3-sleep-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="875" y="470" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p3-has-emotion" value="Есть данные&lt;br&gt;об эмоциях?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="640" y="450" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="p3-emotional" value="emotionalResource =&lt;br&gt;clamp(55 + support × 25 − strain × 40, 0…100)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="310" y="430" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="p3-add-emotion" value="Добавить компонент&lt;br&gt;(emotionalResource, weight = 0,35)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="290" y="535" width="320" height="64" as="geometry"/></mxCell>
        <mxCell id="p3-emotion-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="660" y="590" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p3-empty" value="components пуст?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="830" y="575" width="135" height="90" as="geometry"/></mxCell>
        <mxCell id="p3-default" value="resourceScore = 50" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1050" y="550" width="240" height="54" as="geometry"/></mxCell>
        <mxCell id="p3-total-weight" value="totalWeight = Σ weight" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1040" y="665" width="250" height="52" as="geometry"/></mxCell>
        <mxCell id="p3-weighted" value="weightedScore =&lt;br&gt;Σ(value × weight) / totalWeight" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1370" y="650" width="310" height="66" as="geometry"/></mxCell>
        <mxCell id="p3-round" value="resourceScore =&lt;br&gt;round(clamp(weightedScore, 0…100))" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1370" y="755" width="310" height="66" as="geometry"/></mxCell>
        <mxCell id="p3-final-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1160" y="790" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p3-output" value="Вернуть resourceScore ∈ 0…100" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=15;" parent="1" vertex="1"><mxGeometry x="815" y="900" width="310" height="58" as="geometry"/></mxCell>
        <mxCell id="p3-note-normalization" value="Вес компонента нормализуется через totalWeight. Поэтому при наличии только одного компонента итог равен его оценке, а не оценке, умноженной на 0,65 или 0,35." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="130" y="760" width="440" height="105" as="geometry"/></mxCell>
        <mxCell id="p3-final" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="950" y="1040" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="p3-final-dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="957" y="1047" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="p3-final-label" value="&lt;b&gt;Конец&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="995" y="1045" width="70" height="24" as="geometry"/></mxCell>

        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-start" target="p3-input" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-input" target="p3-components" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-components" target="p3-has-sleep" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e4" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-has-sleep" target="p3-current" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e5" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-has-sleep" target="p3-sleep-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-current" target="p3-has-average" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e7" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-has-average" target="p3-trend-score" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e8" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-has-average" target="p3-trend-current" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-trend-score" target="p3-trend-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-trend-current" target="p3-trend-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-trend-merge" target="p3-combined" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-combined" target="p3-add-sleep" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-add-sleep" target="p3-sleep-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-sleep-merge" target="p3-has-emotion" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e15" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-has-emotion" target="p3-emotional" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-emotional" target="p3-add-emotion" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-add-emotion" target="p3-emotion-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e18" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-has-emotion" target="p3-emotion-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-emotion-merge" target="p3-empty" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e20" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-empty" target="p3-default" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e21" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p3-empty" target="p3-total-weight" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-total-weight" target="p3-weighted" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-weighted" target="p3-round" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-default" target="p3-final-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-round" target="p3-final-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-final-merge" target="p3-output" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p3-output" target="p3-final" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="tasks-workload" name="4. Задачи и трудоёмкость">
    <mxGraphModel dx="2100" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="&lt;b&gt;Подпроцесс 3. Подготовка задач и расчёт показателей трудоёмкости&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#000000;fontSize=20;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="20" width="2060" height="65" as="geometry"/></mxCell>
        <mxCell id="p4-lane" value="&lt;b&gt;UserAnalysisEngine&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=15;fontColor=#000000;align=center;verticalAlign=top;spacingTop=8;" parent="1" vertex="1"><mxGeometry x="20" y="105" width="2060" height="1650" as="geometry"/></mxCell>
        <mxCell id="p4-start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="80" y="175" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="p4-start-label" value="&lt;b&gt;Начало&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="25" y="173" width="45" height="24" as="geometry"/></mxCell>
        <mxCell id="p4-input" value="Получить todayTasks и tomorrowTasks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="150" y="158" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="p4-flatten-today" value="Преобразовать todayTasks в рабочие элементы:&lt;br&gt;если задача сложная и имеет подзадачи — использовать подзадачи;&lt;br&gt;иначе — саму задачу" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="520" y="135" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-split" value="Разделить рабочие элементы сегодня:&lt;br&gt;todayItems = невыполненные;&lt;br&gt;completedItems = выполненные" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1020" y="145" width="350" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-flatten-tomorrow" value="Так же развернуть tomorrowTasks;&lt;br&gt;оставить только невыполненные → tomorrowItems" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1440" y="145" width="380" height="72" as="geometry"/></mxCell>

        <mxCell id="p4-counts" value="Рассчитать:&lt;br&gt;todayTaskCount, completedTaskCount,&lt;br&gt;tomorrowTaskCount" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="160" y="335" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="p4-hard" value="Посчитать «трудные» элементы:&lt;br&gt;difficulty ≥ 7 ИЛИ importance ≥ 8" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="540" y="342" width="330" height="66" as="geometry"/></mxCell>
        <mxCell id="p4-average-diff" value="Если todayItems пуст — averageDifficulty = 0;&lt;br&gt;иначе averageDifficulty = Σ difficulty / count" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="950" y="335" width="390" height="78" as="geometry"/></mxCell>
        <mxCell id="p4-estimated" value="Для каждого элемента ограничить длительность&lt;br&gt;диапазоном 15…480 минут;&lt;br&gt;суммировать отдельно выполненное и оставшееся" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1420" y="330" width="420" height="88" as="geometry"/></mxCell>

        <mxCell id="p4-call-today" value="Вычислить workloadScore(todayItems)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="250" y="560" width="350" height="58" as="geometry"/></mxCell>
        <mxCell id="p4-call-tomorrow" value="Вычислить workloadScore(tomorrowItems)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="250" y="660" width="350" height="58" as="geometry"/></mxCell>
        <mxCell id="p4-workload-input" value="Подробное поведение каждого вызова&lt;br&gt;workloadScore(tasks)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="720" y="540" width="340" height="64" as="geometry"/></mxCell>
        <mxCell id="p4-empty" value="tasks пуст?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1100" y="530" width="125" height="88" as="geometry"/></mxCell>
        <mxCell id="p4-zero" value="Вернуть 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1310" y="500" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="p4-count-pressure" value="taskCountPressure =&lt;br&gt;min(tasks.count / 7, 1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1300" y="610" width="250" height="62" as="geometry"/></mxCell>
        <mxCell id="p4-duration" value="estimatedSeconds = Σ clamp(estimatedDuration,&lt;br&gt;15 минут…8 часов);&lt;br&gt;estimatedHours = estimatedSeconds / 3600" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1600" y="595" width="390" height="82" as="geometry"/></mxCell>
        <mxCell id="p4-duration-pressure" value="durationPressure = min(estimatedHours / 7, 1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1590" y="730" width="390" height="56" as="geometry"/></mxCell>
        <mxCell id="p4-difficulty-pressure" value="difficultyPressure =&lt;br&gt;Σ clamp(difficulty, 1…10) / count / 10" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1160" y="735" width="330" height="68" as="geometry"/></mxCell>
        <mxCell id="p4-importance-pressure" value="importancePressure =&lt;br&gt;Σ clamp(importance, 1…10) / count / 10" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="760" y="735" width="330" height="68" as="geometry"/></mxCell>
        <mxCell id="p4-formula" value="score = min(100,&lt;br&gt;(countPressure × 0,28 + durationPressure × 0,34 +&lt;br&gt;difficultyPressure × 0,24 + importancePressure × 0,14) × 100)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="750" y="870" width="610" height="84" as="geometry"/></mxCell>
        <mxCell id="p4-workload-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1420" y="885" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p4-save-workloads" value="Сохранить todayWorkloadScore&lt;br&gt;и tomorrowWorkloadScore" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1570" y="870" width="330" height="66" as="geometry"/></mxCell>

        <mxCell id="p4-output" value="Передать далее:&lt;br&gt;todayItems, completedItems, tomorrowItems;&lt;br&gt;количества задач, трудные задачи, среднюю сложность;&lt;br&gt;оценочные минуты; todayWorkloadScore и tomorrowWorkloadScore" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="660" y="1130" width="720" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-note" value="workloadScore отражает общую трудоёмкость списка задач. Он используется в метриках текущего и следующего дня. Фактическая загрузка текущего дня рассчитывается отдельно на странице 5 с учётом доступного времени и календарных событий." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="110" y="1060" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="p4-final" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1000" y="1360" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="p4-final-dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1007" y="1367" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="p4-final-label" value="&lt;b&gt;Конец&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1045" y="1365" width="70" height="24" as="geometry"/></mxCell>

        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-start" target="p4-input" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-input" target="p4-flatten-today" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-flatten-today" target="p4-split" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-split" target="p4-flatten-tomorrow" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-flatten-tomorrow" target="p4-counts" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-counts" target="p4-hard" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-hard" target="p4-average-diff" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-average-diff" target="p4-estimated" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-estimated" target="p4-call-today" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-call-today" target="p4-call-tomorrow" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-call-tomorrow" target="p4-workload-input" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-workload-input" target="p4-empty" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e13" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p4-empty" target="p4-zero" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e14" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p4-empty" target="p4-count-pressure" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-count-pressure" target="p4-duration" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-duration" target="p4-duration-pressure" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-duration-pressure" target="p4-difficulty-pressure" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-difficulty-pressure" target="p4-importance-pressure" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-importance-pressure" target="p4-formula" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-zero" target="p4-workload-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-formula" target="p4-workload-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-workload-merge" target="p4-save-workloads" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-save-workloads" target="p4-output" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p4-output" target="p4-final" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="day-load-final-scores" name="5. Нагрузка и итоговые оценки">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="&lt;b&gt;Подпроцесс 4. Расчёт фактической нагрузки, баланса и достоверности&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#000000;fontSize=20;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="20" width="2160" height="65" as="geometry"/></mxCell>
        <mxCell id="p5-lane" value="&lt;b&gt;UserAnalysisEngine&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=15;fontColor=#000000;align=center;verticalAlign=top;spacingTop=8;" parent="1" vertex="1"><mxGeometry x="20" y="105" width="2160" height="1900" as="geometry"/></mxCell>
        <mxCell id="p5-start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="80" y="175" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="p5-start-label" value="&lt;b&gt;Начало&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="25" y="173" width="45" height="24" as="geometry"/></mxCell>
        <mxCell id="p5-input" value="Получить date, todayItems,&lt;br&gt;completedItems и resourceScore" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="150" y="155" width="310" height="68" as="geometry"/></mxCell>
        <mxCell id="p5-separate" value="Разделить оставшиеся элементы:&lt;br&gt;fixedEvents — source = calendar;&lt;br&gt;flexibleTasks — остальные" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="540" y="145" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="p5-base-time" value="workStart = 08:00; workEnd = 22:00;&lt;br&gt;start = max(date, workStart);&lt;br&gt;если start ≥ workEnd → baseAvailable = 0;&lt;br&gt;иначе baseAvailable = min(480, минуты(start…workEnd))" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="960" y="130" width="480" height="100" as="geometry"/></mxCell>
        <mxCell id="p5-note-window" value="Текущее ограничение реализации — до 22:00 и максимум 8 часов доступного времени. Это отличается от ранее сформулированного требования о границе 23:00." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1530" y="130" width="410" height="105" as="geometry"/></mxCell>

        <mxCell id="p5-intervals" value="Для каждого fixedEvent построить интервал:&lt;br&gt;start = max(date, event.startDate);&lt;br&gt;end = min(workEnd, event.deadlineDate)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="140" y="360" width="370" height="84" as="geometry"/></mxCell>
        <mxCell id="p5-filter-intervals" value="Удалить интервалы end ≤ start;&lt;br&gt;отсортировать оставшиеся по start" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="580" y="370" width="330" height="64" as="geometry"/></mxCell>
        <mxCell id="p5-any-interval" value="Есть интервалы?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="990" y="355" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="p5-fixed-zero" value="fixedMinutes = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1200" y="330" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="p5-merge-intervals" value="Последовательно объединять&lt;br&gt;пересекающиеся и соприкасающиеся интервалы;&lt;br&gt;суммировать длину объединённых интервалов" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1200" y="415" width="430" height="82" as="geometry"/></mxCell>
        <mxCell id="p5-fixed-minutes" value="fixedMinutes = totalSeconds / 60" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1700" y="430" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="p5-fixed-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1905" y="550" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p5-available" value="availableFocusMinutes =&lt;br&gt;max(0, baseAvailable − fixedMinutes)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1510" y="620" width="350" height="64" as="geometry"/></mxCell>

        <mxCell id="p5-weighted" value="weightedEffort(tasks): для каждой задачи&lt;br&gt;minutes = clamp(durationMinutes, 15…480);&lt;br&gt;difficultyFactor = 0,75 + clamp(difficulty, 1…10) × 0,05;&lt;br&gt;результат = Σ(minutes × difficultyFactor)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="120" y="650" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="p5-efforts" value="remainingEffort = weightedEffort(flexibleTasks);&lt;br&gt;completedEffort = weightedEffort(completedItems);&lt;br&gt;overdueCount = число todayItems с deadlineDate &lt; date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="700" y="665" width="450" height="90" as="geometry"/></mxCell>
        <mxCell id="p5-pressures" value="remainingPressure = min(1, remainingEffort / max(60, availableFocusMinutes) / 1,5)&lt;br&gt;spentPressure = min(1, completedEffort / 480)&lt;br&gt;urgencyPressure = min(1, overdueCount / 3)&lt;br&gt;fragmentationPressure = min(1, todayItems.count / 8)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1240" y="760" width="670" height="105" as="geometry"/></mxCell>
        <mxCell id="p5-load" value="loadScore = round(min(100,&lt;br&gt;remainingPressure × 80 + spentPressure × 12 +&lt;br&gt;urgencyPressure × 6 + fragmentationPressure × 2))" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="760" y="850" width="520" height="82" as="geometry"/></mxCell>
        <mxCell id="p5-balance" value="balanceScore = round(clamp(&lt;br&gt;50 + (resourceScore − loadScore) × 0,65,&lt;br&gt;0…100))" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="200" y="850" width="400" height="82" as="geometry"/></mxCell>

        <mxCell id="p5-confidence" value="confidenceScore начинается с 20:&lt;br&gt;+10, если указана дата рождения;&lt;br&gt;+30, если найдена запись сна;&lt;br&gt;+15, если за 7 дней ≥ 3 записей сна;&lt;br&gt;+25, если есть запись эмоций за текущий день;&lt;br&gt;итог ограничить значением 100" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1450" y="960" width="470" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-confidence-level" value="Определить confidenceLevel:&lt;br&gt;0…44 — low;&lt;br&gt;45…74 — medium;&lt;br&gt;75…100 — high" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="990" y="1000" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="p5-low" value="confidenceLevel = low?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="700" y="995" width="150" height="96" as="geometry"/></mxCell>
        <mxCell id="p5-ready-resource" value="readinessScore = resourceScore" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="300" y="965" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="p5-ready-balance" value="readinessScore = balanceScore" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="300" y="1060" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="p5-ready-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="440" y="1165" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p5-level" value="Определить workloadLevel по loadScore:&lt;br&gt;0…27 — low («Лёгкий день»);&lt;br&gt;28…57 — balanced; 58…77 — high;&lt;br&gt;78…100 — overloaded" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="650" y="1180" width="430" height="100" as="geometry"/></mxCell>
        <mxCell id="p5-metrics" value="Собрать UserAnalysisMetrics:&lt;br&gt;сон, тренды, эмоции, количества задач, трудоёмкость,&lt;br&gt;доступное время, календарные события, просрочки,&lt;br&gt;workloadScore для сегодня и завтра" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1180" y="1175" width="570" height="110" as="geometry"/></mxCell>
        <mxCell id="p5-output" value="Передать на формирование результата:&lt;br&gt;resourceScore, loadScore, balanceScore, readinessScore,&lt;br&gt;confidenceScore, confidenceLevel, workloadLevel и metrics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="760" y="1450" width="680" height="95" as="geometry"/></mxCell>
        <mxCell id="p5-final" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1080" y="1640" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="p5-final-dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1087" y="1647" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="p5-final-label" value="&lt;b&gt;Конец&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1125" y="1645" width="70" height="24" as="geometry"/></mxCell>

        <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-start" target="p5-input" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-input" target="p5-separate" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-separate" target="p5-base-time" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-base-time" target="p5-intervals" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-intervals" target="p5-filter-intervals" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-filter-intervals" target="p5-any-interval" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e7" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p5-any-interval" target="p5-fixed-zero" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e8" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p5-any-interval" target="p5-merge-intervals" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-merge-intervals" target="p5-fixed-minutes" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-fixed-zero" target="p5-fixed-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-fixed-minutes" target="p5-fixed-merge" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p5-fixed-merge" target="p5-available" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
