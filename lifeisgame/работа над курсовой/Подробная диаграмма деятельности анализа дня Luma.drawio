        <mxCell id="p2-birth" value="Дата рождения&lt;br&gt;указана?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="490" y="145" width="125" height="88" as="geometry"/></mxCell>
        <mxCell id="p2-age" value="age = max(0, число полных лет&lt;br&gt;между birthDate и date)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="690" y="125" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-age-nil" value="age = nil" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="720" y="220" width="170" height="48" as="geometry"/></mxCell>
        <mxCell id="p2-age-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1050" y="170" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-range" value="Определить рекомендуемый&lt;br&gt;диапазон сна по возрасту" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1170" y="155" width="280" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-range-note" value="Диапазоны, мин:&lt;br&gt;0 лет: 720–960; 1–2: 660–840;&lt;br&gt;3–5: 600–780; 6–12: 540–720;&lt;br&gt;13–17: 480–600; 61–64: 420–540;&lt;br&gt;65+: 420–480; остальные и age=nil: 420–540." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1500" y="125" width="335" height="145" as="geometry"/></mxCell>

        <mxCell id="p2-sleep-today" value="Есть запись сна&lt;br&gt;за date?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="190" y="350" width="135" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-select-today" value="Выбрать запись за date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="410" y="330" width="225" height="54" as="geometry"/></mxCell>
        <mxCell id="p2-sleep-yesterday" value="Есть запись сна&lt;br&gt;за date − 1 день?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="410" y="420" width="145" height="96" as="geometry"/></mxCell>
        <mxCell id="p2-select-yesterday" value="Выбрать запись&lt;br&gt;за предыдущий день" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="680" y="415" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p2-no-sleep" value="sleep = nil;&lt;br&gt;sleepMinutes = nil" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="680" y="500" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-sleep-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1010" y="405" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-sleep-duration" value="Если запись выбрана:&lt;br&gt;sleepMinutes = durationMinutes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1140" y="397" width="280" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-period" value="Задать период последних 7 дней:&lt;br&gt;start = date − 6 дней;&lt;br&gt;end = date + 1 день" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1490" y="390" width="300" height="78" as="geometry"/></mxCell>

        <mxCell id="p2-filter-sleep" value="recent = записи сна,&lt;br&gt;где start ≤ dayDate &lt; end" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="150" y="650" width="270" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-recent-empty" value="recent пуст?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="500" y="638" width="125" height="88" as="geometry"/></mxCell>
        <mxCell id="p2-trend-empty" value="averageMinutes = nil;&lt;br&gt;variation = nil;&lt;br&gt;entryCount = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="700" y="585" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="p2-average-sleep" value="averageMinutes =&lt;br&gt;Σ durationMinutes / recent.count" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="700" y="690" width="275" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-normalize" value="Для каждого bedtime вычислить минуту отбоя:&lt;br&gt;(hour &lt; 12 ? hour + 24 : hour) × 60 + minute" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1040" y="680" width="380" height="74" as="geometry"/></mxCell>
        <mxCell id="p2-variation" value="averageBedtime = Σ bedtimeMinute / count;&lt;br&gt;variation = Σ |bedtimeMinute − averageBedtime| / count;&lt;br&gt;entryCount = recent.count" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1470" y="670" width="355" height="88" as="geometry"/></mxCell>
        <mxCell id="p2-trend-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="900" y="805" width="50" height="50" as="geometry"/></mxCell>

        <mxCell id="p2-filter-emotion" value="todayEntries = записи эмоций,&lt;br&gt;относящиеся к date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="130" y="950" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-emotion-empty" value="todayEntries пуст?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="500" y="938" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-emotion-zero" value="balance = nil;&lt;br&gt;strain = 0;&lt;br&gt;support = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="710" y="875" width="220" height="72" as="geometry"/></mxCell>
        <mxCell id="p2-emotion-score" value="Для каждой записи:&lt;br&gt;direction = valence(тип эмоции);&lt;br&gt;score = intensity / 10 × direction" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="700" y="1000" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="p2-negative" value="negativeScores =&lt;br&gt;|score| для score &lt; 0;&lt;br&gt;strain = max или 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1080" y="970" width="260" height="82" as="geometry"/></mxCell>
        <mxCell id="p2-positive" value="positiveScores =&lt;br&gt;score для score &gt; 0;&lt;br&gt;support = max или 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1080" y="1085" width="260" height="82" as="geometry"/></mxCell>
        <mxCell id="p2-balance" value="balance = Σ score / todayEntries.count" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1430" y="1025" width="310" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-emotion-merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1515" y="1175" width="50" height="50" as="geometry"/></mxCell>

        <mxCell id="p2-output" value="Передать в следующие подпроцессы:&lt;br&gt;age, recommendedSleepRange, sleepMinutes,&lt;br&gt;averageSleepMinutes, scheduleVariation, entryCount,&lt;br&gt;emotionBalance, emotionalStrain, emotionalSupport" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" parent="1" vertex="1"><mxGeometry x="650" y="1390" width="600" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-note-valence" value="valence задаётся типом эмоции. Неизвестное имя эмоции даёт direction = 0. В текущем алгоритме интенсивность используется как сохранена в записи." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="130" y="1270" width="390" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-final" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="935" y="1570" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="p2-final-dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="942" y="1577" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="p2-final-label" value="&lt;b&gt;Конец&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="980" y="1575" width="70" height="24" as="geometry"/></mxCell>

        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p2-start" target="p2-input" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;" parent="1" source="p2-input" target="p2-birth" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e3" value="[да]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p2-birth" target="p2-age" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e4" value="[нет]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1;fontSize=12;" parent="1" source="p2-birth" target="p2-age-nil" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
